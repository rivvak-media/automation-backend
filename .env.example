# Server Configuration
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# Multi-Tenant Authentication (replace with a strong secret in production)
ADMIN_PASSCODE=CHANGE-ME-ADMIN-PASSCODE

# Scheduler Engine (60000ms = 1 minute)
SCHEDULER_INTERVAL_MS=60000

# CORS Extra Allowed Origins (comma-separated; rivvak.com, www.rivvak.com, localhost:*, 127.0.0.1:* are always allowed)
ALLOWED_ORIGINS=https://rivvak.com,https://www.rivvak.com,http://127.0.0.1,http://localhost

# Public Lead Auto-Reply ("false" disables branded confirmation email to valid lead email)
AUTO_REPLY_LEADS=true

# Email Delivery Priority: 1) Resend API, 2) Native TLS SMTP, 3) Honest dry_run_queued
RESEND_API_KEY=
RESEND_FROM=Rivvak Media <connect@rivvak.com>

# Native TLS SMTP (e.g., Namecheap Private Email mail.privateemail.com:465 or STARTTLS :587)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=connect@rivvak.com
SMTP_PASS=
SMTP_FROM=Rivvak Media <connect@rivvak.com>

# Native TLS IMAP Read-Only Inbox Summary (/api/admin/email-inbox)
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993

# Stripe Webhook Verification Secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Twilio SMS (optional - runs in honest dry_run_queued mode when absent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta Graph API & Instagram DM Webhook (optional - runs in honest dry_run_queued mode when absent)
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_AD_ACCOUNT_ID=
META_VERIFY_TOKEN=CHANGE-ME-META-VERIFY-TOKEN

# Global Make / n8n / Zapier Automation Webhook (optional)
WEBHOOK_URL=
